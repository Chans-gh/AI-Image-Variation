{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/image-variations/contracts/direction-registry-1.0.schema.json",
  "title": "Image Variations Direction Registry v1.0",
  "type": "object",
  "required": ["registry_version", "directions"],
  "properties": {
    "registry_version": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "directions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/direction"}}
  },
  "$defs": {
    "direction": {
      "type": "object",
      "required": ["key", "label", "version", "modes", "allowed_changes", "must_preserve", "avoid", "variation_examples", "branch_defaults", "grid_rules", "sequence_rules"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "deprecated", "experimental"]},
        "modes": {"type": "array", "items": {"enum": ["grid", "sequence"]}, "minItems": 1, "uniqueItems": true},
        "allowed_changes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "must_preserve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "avoid": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "variation_examples": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "branch_defaults": {
          "type": "object",
          "required": ["default", "supported"],
          "properties": {
            "default": {"enum": ["variants", "progression", "narrative"]},
            "supported": {"type": "array", "items": {"enum": ["variants", "progression", "narrative"]}, "minItems": 1, "uniqueItems": true}
          },
          "additionalProperties": true
        },
        "grid_rules": {
          "type": "object",
          "properties": {
            "row_major": {"type": "boolean"},
            "no_border_no_gap": {"type": "boolean"},
            "no_sequence_semantics": {"type": "boolean"},
            "cell_hint": {"type": "string"}
          },
          "additionalProperties": true
        },
        "sequence_rules": {
          "type": "object",
          "properties": {
            "min_frames": {"type": "integer", "minimum": 4},
            "max_frames": {"type": "integer", "maximum": 16},
            "progression_axis_hint": {"type": "string"},
            "narrative_context_required": {"type": "boolean"}
          },
          "additionalProperties": true
        },
        "notes": {"type": "string"},
        "source_ref": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$comment": "注册表只描述规则数据；新增第 13 个方向时只允许新增 direction 记录，不得要求改动 Skill 主流程分支（SPEC 00 §00.7 第 3 条）。"
}
