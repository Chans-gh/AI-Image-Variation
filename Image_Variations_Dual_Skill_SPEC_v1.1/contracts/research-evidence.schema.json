{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/image-variations/contracts/research-evidence-1.1.schema.json",
  "title": "Research Evidence Pack v1.1",
  "type": "object",
  "required": ["research_level", "search_performed", "status", "claims"],
  "properties": {
    "research_level": {"enum": ["R0", "R1", "R2"]},
    "search_performed": {"type": "boolean"},
    "status": {"enum": ["not_required", "verified", "partially_verified", "unavailable", "failed"]},
    "search_provider": {"type": "string"},
    "tools": {"type": "array", "items": {"type": "string"}},
    "queries": {"type": "array", "items": {"type": "string"}},
    "searched_at": {"type": "string", "format": "date-time"},
    "notes": {"type": "string"},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["claim_id", "claim", "support_status"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "support_status": {"enum": ["verified", "partial", "unsupported", "disputed"]},
        "source_type": {"enum": ["primary", "secondary", "community", "image_observation", "model_prior"]},
        "source_title": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "publisher": {"type": "string"},
        "published_at": {"type": "string"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "verified_at": {"type": "string", "format": "date-time"},
        "contradicted_by": {"type": "array", "items": {"type": "string"}},
        "used_by_content_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$comment": "claim_id 唯一、used_by_content_ids 与 content-artifact 的 claim_ids 双向一致、support_status=verified 的 claim 必须含真实来源与检索时间，均由业务校验器核对。"
}
