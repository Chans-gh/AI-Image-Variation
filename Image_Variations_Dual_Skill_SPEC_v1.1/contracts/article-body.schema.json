{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/image-variations/contracts/article-body-1.1.schema.json",
  "title": "WeChat Article Content Blocks v1.1",
  "type": "object",
  "required": ["title", "summary", "blocks"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "topic_id": {"type": "string"},
    "content_id": {"type": "string"},
    "language": {"enum": ["zh-CN", "en", "other"]},
    "blocks_version": {"const": "1.1"},
    "blocks": {
      "type": "array",
      "minItems": 3,
      "items": {"oneOf": [
        {"$ref": "#/$defs/text_block"},
        {"$ref": "#/$defs/image_block"},
        {"$ref": "#/$defs/image_group_block"}
      ]}
    }
  },
  "$defs": {
    "text_block": {
      "type": "object",
      "required": ["type", "content"],
      "properties": {
        "type": {"const": "text"},
        "content": {"type": "string", "minLength": 1},
        "heading": {"type": "string"},
        "level": {"enum": ["h2", "h3"]}
      },
      "additionalProperties": true
    },
    "image_block": {
      "type": "object",
      "required": ["type", "asset_id"],
      "properties": {
        "type": {"const": "image"},
        "asset_id": {"type": "string", "minLength": 1},
        "alt": {"type": "string"},
        "caption": {"type": "string"}
      },
      "additionalProperties": true
    },
    "image_group_block": {
      "type": "object",
      "required": ["type", "images"],
      "properties": {
        "type": {"const": "image_group"},
        "caption": {"type": "string"},
        "images": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["asset_id"],
            "properties": {
              "asset_id": {"type": "string", "minLength": 1},
              "alt": {"type": "string"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$comment": "块序列规则（首尾必须为 text、image/image_group 不得相邻、image_group 内 2–4 张、text 块数等于图块数 +1）由业务校验器验证；JSON Schema 无法表达带位置约束的序列模式。"
}
