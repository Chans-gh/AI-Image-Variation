{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/image-variations/contracts/job-state-1.0.schema.json",
  "title": "Skill Job State v1.0",
  "type": "object",
  "required": ["job_id", "skill", "status", "phase", "progress", "created_at", "updated_at"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "skill": {"enum": ["image_variations", "image_content_publishing"]},
    "status": {"enum": ["queued", "running", "awaiting_selection", "completed", "partial", "partial_failed", "failed", "cancelled"]},
    "phase": {
      "enum": [
        "queued", "planning", "generating", "validating", "postprocessing",
        "validating_source", "understanding", "awaiting_selection", "researching",
        "assembling", "validating_output", "packaging", "done"
      ]
    },
    "artifact_revision": {"type": "string"},
    "progress": {
      "type": "object",
      "required": ["completed_count", "total_count"],
      "properties": {
        "completed_count": {"type": "integer", "minimum": 0},
        "total_count": {"type": "integer", "minimum": 0},
        "unit": {"type": "string"},
        "current_item": {"type": "string"}
      },
      "additionalProperties": true
    },
    "execution": {"type": "object"},
    "retry_counts": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "item_ref": {"type": "string"},
          "asset_id": {"type": "string"},
          "recoverable": {"type": "boolean"},
          "retry_available": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "resume_hint": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true,
  "$comment": "错误码必须来自 shared 错误码注册表（references/error-registry.json）；状态转换合法性与断点续跑语义由业务校验器验证。"
}
