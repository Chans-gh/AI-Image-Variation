{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/image-variations/contracts/delivery-package-1.0.schema.json",
  "title": "Delivery Package Manifest v1.0",
  "type": "object",
  "required": ["package_id", "package_type", "root", "entries", "manifest_path", "total_files", "created_at"],
  "properties": {
    "package_id": {"type": "string", "minLength": 1},
    "package_type": {"enum": ["image_variations", "content_publishing"]},
    "root": {"type": "string", "minLength": 1},
    "manifest_path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
          "kind": {"enum": ["image", "metadata", "text", "research", "cover", "other"]},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "index": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "total_files": {"type": "integer", "minimum": 1},
    "total_bytes": {"type": "integer", "minimum": 0},
    "archive": {
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "format": {"enum": ["zip", "directory"]}
      },
      "additionalProperties": true
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true,
  "$comment": "打包必须防 ZIP Slip、压缩炸弹和路径覆盖；entries 必须覆盖包内所有文件且哈希与文件一致（references/packaging.md）。"
}
