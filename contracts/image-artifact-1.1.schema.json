{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/image-variations/contracts/image-artifact-1.1.schema.json",
  "title": "Image Variations Image Artifact v1.1",
  "type": "object",
  "required": ["schema_version", "artifact_type", "task_id", "artifact_revision", "status", "input_type", "output_mode", "direction", "image_count", "requested_aspect_ratio", "requested_resolution_tier", "images", "validation", "created_at", "completed_at"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "artifact_type": {"const": "image_variations"},
    "task_id": {"type": "string", "minLength": 1},
    "artifact_revision": {"type": "string", "minLength": 1},
    "parent_artifact_revision": {"type": ["string", "null"]},
    "status": {"enum": ["completed", "partial_failed", "failed"]},
    "input_type": {"enum": ["image_only", "text_only", "image_plus_text"]},
    "output_mode": {"enum": ["grid", "sequence"]},
    "direction": {"type": "string", "minLength": 1},
    "direction_registry_version": {"type": "string", "minLength": 1},
    "branch": {"type": ["string", "null"], "enum": ["variants", "progression", "narrative", null]},
    "grid_size": {"type": ["integer", "null"], "enum": [2, 3, 4, null]},
    "grid_size_source": {"type": "string"},
    "image_count": {"type": "integer", "minimum": 4, "maximum": 16},
    "requested_aspect_ratio": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"},
    "actual_aspect_ratio": {"type": "string", "minLength": 3},
    "requested_resolution_tier": {"enum": ["1K", "2K", "4K"]},
    "requested_resolution_policy": {"enum": ["tile_min_edge_default", "user_override", "provider_degraded"]},
    "provider_type": {"type": "string"},
    "model_id": {"type": "string"},
    "direction_rules_version": {"type": "string"},
    "prompt_template_version": {"type": "string"},
    "consistency_anchor": {"type": "object"},
    "images": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/image"}},
    "validation": {"$ref": "#/$defs/validation"},
    "execution": {"$ref": "#/$defs/execution"},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "errors": {"type": "array", "items": {"type": "object"}},
    "retry_counts": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
      "then": {"required": ["actual_aspect_ratio"]}
    },
    {
      "if": {"properties": {"output_mode": {"const": "grid"}}, "required": ["output_mode"]},
      "then": {
        "required": ["grid_size", "branch"],
        "properties": {
          "grid_size": {"enum": [2, 3, 4]},
          "branch": {"type": "null"},
          "image_count": {"enum": [4, 9, 16]},
          "validation": {"required": ["grid_structure_passed"]}
        }
      }
    },
    {
      "if": {"properties": {"output_mode": {"const": "sequence"}}, "required": ["output_mode"]},
      "then": {
        "required": ["branch", "grid_size"],
        "properties": {
          "grid_size": {"type": "null"},
          "branch": {"enum": ["variants", "progression", "narrative"]}
        }
      }
    }
  ],
  "$defs": {
    "crop_box": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ]
    },
    "image": {
      "type": "object",
      "required": ["id", "kind", "index", "path", "width", "height", "sha256", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["board", "tile", "frame"]},
        "index": {"type": "integer", "minimum": 0},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "format": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "status": {"enum": ["completed", "failed"]},
        "row": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "crop_box": {"$ref": "#/$defs/crop_box"},
        "phase_label": {"type": "string"},
        "story_context": {"type": "string"},
        "prompt_summary": {"type": "string"},
        "prompt_template_id": {"type": "string"},
        "seed": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "board"}}, "required": ["kind"]},
          "then": {"properties": {"index": {"const": 0}}}
        },
        {
          "if": {"properties": {"kind": {"const": "tile"}}, "required": ["kind"]},
          "then": {
            "properties": {"index": {"minimum": 1}},
            "required": ["row", "column", "crop_box"]
          }
        },
        {
          "if": {"properties": {"kind": {"const": "frame"}}, "required": ["kind"]},
          "then": {"properties": {"index": {"minimum": 1}}}
        }
      ],
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "required": ["asset_integrity_passed"],
      "properties": {
        "asset_integrity_passed": {"type": "boolean"},
        "grid_structure_passed": {"type": "boolean"},
        "sequence_complete": {"type": "boolean"},
        "aspect_ratio_error_ratio": {"type": "number", "minimum": 0},
        "tile_edge_px": {"type": "integer", "minimum": 1},
        "tile_edge_min_required_px": {"type": "integer", "minimum": 1},
        "tile_edge_ok": {"type": "boolean"},
        "seam_score": {"type": "number", "minimum": 0, "maximum": 1},
        "seam_check_method": {"type": "string"},
        "grid_attempts": {"type": "integer", "minimum": 1},
        "checks": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "calls_planned": {"type": "integer", "minimum": 0},
        "calls_used": {"type": "integer", "minimum": 0},
        "call_budget_limit": {"type": ["integer", "null"], "minimum": 0},
        "budget_exceeded": {"type": "boolean"},
        "cost_estimate": {"type": ["number", "null"], "minimum": 0},
        "cost_currency": {"type": "string"},
        "degradations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string"},
        "severity": {"enum": ["info", "warning", "risk"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$comment": "语义约束（NxN 结构、tile 数等于 image_count、crop_box 无重叠无缝覆盖整板、frame 索引连续、direction 在注册表内、哈希与真实文件一致）由业务校验器验证，JSON Schema 不单独保证。"
}
