{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/image-variations/contracts/topic-plan-1.1.schema.json",
  "title": "Image Content Publishing Topic Plan v1.1",
  "type": "object",
  "required": ["topic_id", "platform", "candidate_title", "angle", "audience", "core_thesis", "outline", "selected_asset_ids", "research_level"],
  "properties": {
    "topic_id": {"type": "string", "minLength": 1},
    "theme_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["wechat", "xiaohongshu"]},
    "candidate_title": {"type": "string", "minLength": 1},
    "angle": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "core_thesis": {"type": "string", "minLength": 1},
    "outline": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "selected_asset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "asset_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "order"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "research_level": {"enum": ["R0", "R1", "R2"]},
    "research_questions": {"type": "array", "items": {"type": "string"}},
    "value_proposition": {"type": "string"},
    "distinct_from_other_topics": {"type": "string"},
    "distinct_from_topic_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dedup_key": {"type": "string"},
    "quality_scorecard": {
      "type": "object",
      "properties": {
        "asset_fit": {"type": "integer", "minimum": 0, "maximum": 5},
        "value": {"type": "integer", "minimum": 0, "maximum": 5},
        "distinctness": {"type": "integer", "minimum": 0, "maximum": 5},
        "verifiability": {"type": ["integer", "null"], "minimum": 0, "maximum": 5},
        "platform_fit": {"type": "integer", "minimum": 0, "maximum": 5},
        "total": {"type": "integer", "minimum": 0, "maximum": 25},
        "passed": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "status": {"enum": ["draft", "candidate", "selected", "used", "dropped"]},
    "content_ids": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true,
  "$comment": "同批选题的实质差异性、图片适配度与事实可证性由选题质量闸门（SPEC 02 §5.3）与人工/模型评分卡判定，Schema 只固化结构。"
}
