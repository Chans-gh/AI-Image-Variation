{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/image-variations/contracts/content-artifact-1.1.schema.json",
  "title": "Image Content Publishing Artifact v1.1",
  "type": "object",
  "required": ["schema_version", "artifact_type", "content_job_id", "revision", "source", "status", "items", "created_at", "completed_at"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "artifact_type": {"const": "content_publishing"},
    "content_job_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "minLength": 1},
    "parent_revision": {"type": ["string", "null"]},
    "source": {"$ref": "#/$defs/source"},
    "status": {"enum": ["completed", "partial", "failed"]},
    "batch": {"$ref": "#/$defs/batch"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "delivery_package": {"$ref": "#/$defs/file"},
    "execution": {"$ref": "#/$defs/execution"},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "errors": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "media_type": {"type": "string"}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["task_id", "artifact_revision", "schema_version"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "artifact_revision": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "minLength": 1},
        "image_manifest_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "output_mode": {"enum": ["grid", "sequence"]},
        "direction": {"type": "string"},
        "branch": {"type": ["string", "null"]},
        "selected_asset_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "batch": {
      "type": "object",
      "properties": {
        "batch_id": {"type": "string", "minLength": 1},
        "planned_item_count": {"type": "integer", "minimum": 1},
        "platforms": {"type": "array", "items": {"enum": ["wechat", "xiaohongshu"]}, "uniqueItems": true},
        "dedup_summary": {"type": "string"},
        "budget": {"$ref": "#/$defs/execution"}
      },
      "additionalProperties": true
    },
    "cover": {
      "type": "object",
      "required": ["file", "source_asset_id", "target_ratio", "actual_width", "actual_height"],
      "properties": {
        "file": {"$ref": "#/$defs/file"},
        "source_asset_id": {"type": "string", "minLength": 1},
        "source_asset_long_edge_px": {"type": "integer", "minimum": 1},
        "crop_box": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "prefixItems": [
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ]
        },
        "target_ratio": {"type": "string", "minLength": 3},
        "actual_width": {"type": "integer", "minimum": 1},
        "actual_height": {"type": "integer", "minimum": 1},
        "fit_method": {"enum": ["crop", "contain_pad"]},
        "upscale_factor": {"type": "number", "minimum": 1},
        "quality_risk": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "research": {
      "type": "object",
      "required": ["level", "status"],
      "properties": {
        "level": {"enum": ["R0", "R1", "R2"]},
        "status": {"enum": ["not_required", "verified", "partially_verified", "unavailable", "failed"]},
        "search_performed": {"type": "boolean"},
        "evidence_file": {"$ref": "#/$defs/file"},
        "queries": {"type": "array", "items": {"type": "string"}},
        "unverified_claims_downgraded": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": ["content_id", "content_revision", "platform", "topic_id", "topic_plan_file", "status", "selected_asset_ids", "claim_ids", "research_level", "research_status", "files", "package_images", "validation"],
      "properties": {
        "content_id": {"type": "string", "minLength": 1},
        "content_revision": {"type": "string", "minLength": 1},
        "revises": {
          "type": "object",
          "required": ["content_id", "content_revision"],
          "properties": {
            "content_id": {"type": "string", "minLength": 1},
            "content_revision": {"type": "string", "minLength": 1},
            "change_scope": {"enum": ["text", "assets", "covers", "research", "structure", "full"]}
          },
          "additionalProperties": true
        },
        "platform": {"enum": ["wechat", "xiaohongshu"]},
        "topic_id": {"type": "string", "minLength": 1},
        "theme_id": {"type": "string", "minLength": 1},
        "topic_plan_file": {"$ref": "#/$defs/file"},
        "status": {"enum": ["completed", "failed", "partial"]},
        "selected_asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "research_level": {"enum": ["R0", "R1", "R2"]},
        "research_status": {"enum": ["not_required", "verified", "partially_verified", "unavailable", "failed"]},
        "research": {"$ref": "#/$defs/research"},
        "files": {"type": "object", "additionalProperties": {"$ref": "#/$defs/file"}},
        "package_images": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "cover_wide": {"$ref": "#/$defs/cover"},
        "cover_square": {"$ref": "#/$defs/cover"},
        "profile_file": {"$ref": "#/$defs/file"},
        "validation": {
          "type": "object",
          "required": ["passed"],
          "properties": {
            "passed": {"type": "boolean"},
            "checks": {"type": "array", "items": {"type": "string"}},
            "failed_checks": {"type": "array", "items": {"type": "string"}},
            "scorecard": {"type": "object"}
          },
          "additionalProperties": true
        },
        "errors": {"type": "array", "items": {"type": "object"}}
      },
      "allOf": [
        {
          "if": {"properties": {"platform": {"const": "wechat"}}, "required": ["platform"]},
          "then": {"required": ["cover_wide", "cover_square"]}
        },
        {
          "if": {"properties": {"platform": {"const": "xiaohongshu"}}, "required": ["platform"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["cover_wide"]},
                {"required": ["cover_square"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "completed"}}, "required": ["status"]},
          "then": {"properties": {"validation": {"properties": {"passed": {"const": true}}}}}
        }
      ],
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "properties": {
        "text_calls_used": {"type": "integer", "minimum": 0},
        "image_ops_used": {"type": "integer", "minimum": 0},
        "search_calls_used": {"type": "integer", "minimum": 0},
        "call_budget_limit": {"type": ["integer", "null"], "minimum": 0},
        "budget_exceeded": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$comment": "语义约束（正文交替与图集块规则、claim_ids 必须存在于研究证据包、封面同源、package_images 覆盖包内全部图片、topic_plan_file 可解析）由业务校验器验证。"
}
