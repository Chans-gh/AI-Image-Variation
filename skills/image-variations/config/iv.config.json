      "2K": 0.08,
      "4K": 0.16
    },
    "cost_currency": "USD"
  },
  "sequence": {
    "min_frames": 4,
    "max_frames": 16,
    "near_duplicate_similarity_max": 0.9
  },
  "grid": {
    "allowed_sizes": [2, 3, 4]
  },
  "defaults": {
    "output_mode": "grid",
    "grid_size": 3,
    "direction": "state",
    "sequence_image_count": 4,
    "text_only_aspect_ratio": "3:4",
    "sequence_resolution_tier": "1K"
  },
  "local_endpoint": {
    "allow_local_endpoint": false,
    "allowed_hosts": ["127.0.0.1", "localhost"]
  },
  "packaging": {
    "max_entry_bytes": 209715200,
    "max_total_bytes": 2147483648,
    "max_entries": 5000,
    "max_compression_ratio": 200
