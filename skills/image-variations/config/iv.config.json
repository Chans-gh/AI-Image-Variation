{
  "config_version": "1.0",
  "note": "Skill 01 唯一的阈值来源。规范已声明这些数值未经真实模型校准（DECISIONS E5、O-10）：真实服务实测后只改本文件，不得改动代码。",
  "tile_edge_min_px": 1024,
  "tile_edge_warn_px": 768,
