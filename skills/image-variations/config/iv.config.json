  "seam": {
    "method": "boundary_gradient_v1",
    "band_px": 2,
    "epsilon": 0.000001,
    "pass_threshold": 0.85,
    "risk_threshold": 0.60,
    "border_line_detect": {
      "min_run_px": 3,
      "min_contrast": 24.0,
      "blank_band_std_max": 3.0
    }
  },
  "retry": {
    "grid_max_attempts": 3,
    "frame_max_extra_retries": 2,
    "backoff_base_sec": 1.0,
    "backoff_max_sec": 30.0,
    "jitter_ratio": 0.25,
    "retry_on": ["RATE_LIMITED", "PROVIDER_TIMEOUT", "IMAGE_VALIDATION_FAILED", "GRID_VALIDATION_FAILED"],
    "never_retry_on": ["AUTH_FAILED", "MODEL_REFUSAL", "UNSUPPORTED_RATIO", "UNSUPPORTED_RESOLUTION",
